# Anthropic API key for Claude AI analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Polymarket CLOB API credentials
# Get these from https://polymarket.com by connecting your wallet
POLY_API_KEY=your_polymarket_api_key
POLY_API_SECRET=your_polymarket_api_secret
POLY_API_PASSPHRASE=your_polymarket_api_passphrase
POLY_PRIVATE_KEY=your_wallet_private_key

# Bot configuration
MAX_BET_USDC=10.0          # Maximum USDC per trade
MIN_EDGE=0.05              # Minimum edge (5%) to trigger a trade
MAX_DAILY_SPEND_USDC=100.0 # Maximum daily spend
DRY_RUN=true               # Set to false to place real orders
LOG_LEVEL=INFO
